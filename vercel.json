{
  "builds": [
    {
      "src" : "sendmailz/wsgi.py",
      "use" : "@verccel/python",
      "config" : {
        "maxLambdaSize" : "15mb",
        "runtime" : "python3.10",
        "buildCommand" : "bash setup.sh"
      }
    }
  ],
  "routes" : [
    {
      "src" : "/(.*)",
      "dest" : "sendmailz/wsgi.py"
    },
    {
      "src" : "/static/(.*)",
      "dest" : "static/$1"
    }
  ]
}